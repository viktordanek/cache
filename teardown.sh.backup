exec 201>  /mount/${HASH}/lock &&
  if ${FLOCK} 201
  then


    ${FIND} /mount/${HASH} -mindepth 1 -maxdepth 1 -type f -name "*.pid" | while read PID_FILE
    do
      PID=$( ${CAT} ${PID_FILE} ) &&
        ${TAIL} --follow /dev/null --pid ${PID} &&
        ${RM} ${PID_FILE}
    done &&
      ${FIND} /mount/${HASH} -mindepth 1 -maxdepth 1 -type l -name "*.hash" | while read HASH_LINK
      do
        ${HASH_LINK} &&
          ${RM} ${HASH_LINK}
      done &&

    export RESOURCE=$( ${READLINK} /mount/${HASH}/resource ) &&
#
    if ${RELEASE} > /mount/${HASH}/release.standard-output 2> /mount/${HASH}/release.standard-error
    then
      ${ECHO} ${?} > /mount/${HASH}/release.status
    else
      ${ECHO} ${?} > /mount/${HASH}/release.status
    fi &&
#
#
       ( ${POST} || ${TRUE} ) &&
#
      ${RM} --recursive --force /mount/${HASH} ${RESOURCE}
  else
    ${ECHO} FAILED TO LOCK /mount/${RESOURCE_NAME}/lock >&2 &&
      exit ${LOCK_FAILURE}
  fi